# Security + caching headers for Cloudflare Pages.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# NOTE on the CSP: the pages use inline `style="..."` attributes throughout, so
# style-src needs 'unsafe-inline'. Inline *script* is NOT allowed — that is the
# directive that actually matters for XSS, and the site only loads /js/forms.js.
# If the inline styles are ever moved into style.css, drop 'unsafe-inline'.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# HTML should always be revalidated so a deploy goes live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static assets can be cached for a while.
/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/screenshots/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# Never cache the form endpoint.
/api/*
  Cache-Control: no-store
